# 配置模板。复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，真实凭据不要提交到仓库。

# 域名
# 部署时通过环境变量设为生产域名
# Traefik 用它来转发流量和申请 TLS 证书
DOMAIN=localhost
# 用于测试本地 Traefik 配置
# DOMAIN=localhost.tiangolo.com

# 前端的公开访问地址，后端用它来生成邮件里的链接。
# 本地开发保持 Vite 的地址；部署时改为应用的实际地址。
FRONTEND_HOST=http://localhost:5173
# 在预发布和生产环境，把这个变量设为前端地址，例如
# FRONTEND_HOST=https://example.com

# 运行环境：local、staging、production
ENVIRONMENT=local

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# 后端
BACKEND_CORS_ORIGINS="http://localhost,https://localhost,http://localhost.tiangolo.com"
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# 邮件
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

SENTRY_DSN=

# Steam 账号 / 临时邮箱服务
# 本地开发留空即可（读信和建邮箱会返回 503），部署到服务器后按实际值填写
# 可用邮箱域名，逗号分隔。每个都需在 Mailcow 添加并配 catch-all 别名
MAIL_DOMAINS=
IMAP_HOST=
IMAP_PORT=993
# 兜底邮箱地址及其 IMAP 密码
CATCHALL_ADDRESS=
CATCHALL_PASSWORD=
# Mailcow 后台地址与管理 API Key（系统 → 配置 → 访问权限 → API）
MAILCOW_BASE_URL=
MAILCOW_API_KEY=
# 禁止转让出去的账号外发邮件，保护出口 IP 声誉
MAILBOX_DISABLE_OUTBOUND=True
# 保存账号时向新邮箱搬运历史邮件的回溯天数
MAIL_MIGRATE_LOOKBACK_DAYS=7
# 兜底邮箱清理任务的保留天数
CATCHALL_RETENTION_DAYS=14
# steam-accounts 接口的 X-API-Key 鉴权密钥，生成方式同 SECRET_KEY
STEAM_API_KEY=

# 改成你自己的 Docker 镜像仓库地址
DOCKER_IMAGE_BACKEND=backend
